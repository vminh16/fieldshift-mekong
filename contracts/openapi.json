{
  "components": {
    "schemas": {
      "CompletedSeason": {
        "properties": {
          "crop": {
            "enum": [
              "rice",
              "maize",
              "soybean",
              "mungbean",
              "sesame",
              "peanut",
              "watermelon",
              "fallow_cover"
            ],
            "title": "Crop",
            "type": "string"
          },
          "harvest": {
            "format": "date",
            "title": "Harvest",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "sow": {
            "format": "date",
            "title": "Sow",
            "type": "string"
          }
        },
        "required": [
          "crop",
          "sow",
          "harvest"
        ],
        "title": "CompletedSeason",
        "type": "object"
      },
      "Constraints": {
        "properties": {
          "budget_level": {
            "anyOf": [
              {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget Level"
          },
          "irrigation": {
            "anyOf": [
              {
                "enum": [
                  "full",
                  "canal_limited",
                  "rainfed"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Irrigation"
          },
          "irrigation_cap_mm": {
            "anyOf": [
              {
                "maximum": 3000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Irrigation Cap Mm"
          },
          "max_changed_seasons": {
            "default": 1,
            "maximum": 6.0,
            "minimum": 0.0,
            "title": "Max Changed Seasons",
            "type": "integer"
          },
          "max_fallow_seasons": {
            "default": 1,
            "maximum": 6.0,
            "minimum": 0.0,
            "title": "Max Fallow Seasons",
            "type": "integer"
          },
          "no_new_machinery": {
            "default": true,
            "title": "No New Machinery",
            "type": "boolean"
          }
        },
        "title": "Constraints",
        "type": "object"
      },
      "EvaluateChainIn": {
        "description": "A rotation chosen by the user, one crop per season of the parent decision's horizon.",
        "properties": {
          "crops": {
            "items": {
              "enum": [
                "rice",
                "maize",
                "soybean",
                "mungbean",
                "sesame",
                "peanut",
                "watermelon",
                "fallow_cover"
              ],
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Crops",
            "type": "array"
          }
        },
        "required": [
          "crops"
        ],
        "title": "EvaluateChainIn",
        "type": "object"
      },
      "FieldIn": {
        "properties": {
          "area_ha": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 10000.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Area Ha"
          },
          "geometry": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Geometry"
          },
          "lat": {
            "description": "MVP: Mekong Delta only",
            "maximum": 11.5,
            "minimum": 8.0,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "maximum": 107.5,
            "minimum": 104.0,
            "title": "Lon",
            "type": "number"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "profile": {
            "$ref": "#/components/schemas/FieldProfile",
            "default": {
              "baseline": [
                "rice",
                "rice",
                "rice"
              ],
              "coastal_salinity_risk": false,
              "drainage": "unknown",
              "equipment": [],
              "history": [],
              "irrigation": "full"
            }
          },
          "region_id": {
            "const": "mekong",
            "default": "mekong",
            "title": "Region Id",
            "type": "string"
          }
        },
        "required": [
          "name",
          "lat",
          "lon"
        ],
        "title": "FieldIn",
        "type": "object"
      },
      "FieldPatch": {
        "properties": {
          "area_ha": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 10000.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Area Ha"
          },
          "geometry": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Geometry"
          },
          "lat": {
            "anyOf": [
              {
                "maximum": 11.5,
                "minimum": 8.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lat"
          },
          "lon": {
            "anyOf": [
              {
                "maximum": 107.5,
                "minimum": 104.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lon"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FieldProfile"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "FieldPatch",
        "type": "object"
      },
      "FieldProfile": {
        "properties": {
          "baseline": {
            "items": {
              "enum": [
                "rice",
                "maize",
                "soybean",
                "mungbean",
                "sesame",
                "peanut",
                "watermelon",
                "fallow_cover"
              ],
              "type": "string"
            },
            "maxItems": 6,
            "minItems": 1,
            "title": "Baseline",
            "type": "array"
          },
          "cache_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cache Key"
          },
          "coastal_salinity_risk": {
            "default": false,
            "title": "Coastal Salinity Risk",
            "type": "boolean"
          },
          "drainage": {
            "default": "unknown",
            "enum": [
              "good",
              "poor",
              "unknown"
            ],
            "title": "Drainage",
            "type": "string"
          },
          "equipment": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Equipment",
            "type": "array"
          },
          "history": {
            "default": [],
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "History",
            "type": "array"
          },
          "irrigation": {
            "default": "full",
            "enum": [
              "full",
              "canal_limited",
              "rainfed"
            ],
            "title": "Irrigation",
            "type": "string"
          }
        },
        "title": "FieldProfile",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ObservationIn": {
        "properties": {
          "evidence_kind": {
            "default": "REPORTED_BY_FARMER",
            "enum": [
              "OBSERVED_FIELD",
              "REPORTED_BY_FARMER"
            ],
            "title": "Evidence Kind",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "observed_at": {
            "format": "date",
            "title": "Observed At",
            "type": "string"
          },
          "unit": {
            "anyOf": [
              {
                "maxLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "value_text": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value Text"
          },
          "variable": {
            "enum": [
              "canal_ecw",
              "soil_ph",
              "drainage",
              "rain_mm",
              "season_closed"
            ],
            "title": "Variable",
            "type": "string"
          }
        },
        "required": [
          "variable",
          "observed_at"
        ],
        "title": "ObservationIn",
        "type": "object"
      },
      "PlanRequest": {
        "properties": {
          "as_of": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "baseline": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "rice",
                    "maize",
                    "soybean",
                    "mungbean",
                    "sesame",
                    "peanut",
                    "watermelon",
                    "fallow_cover"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline"
          },
          "constraints": {
            "$ref": "#/components/schemas/Constraints",
            "default": {
              "max_changed_seasons": 1,
              "max_fallow_seasons": 1,
              "no_new_machinery": true
            }
          },
          "field_id": {
            "title": "Field Id",
            "type": "string"
          },
          "horizon_seasons": {
            "default": 3,
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Horizon Seasons",
            "type": "integer"
          },
          "outlook_modes": {
            "default": [
              "CLIMATOLOGY",
              "STRESS_TEST"
            ],
            "items": {
              "enum": [
                "CLIMATOLOGY",
                "STRESS_TEST",
                "FORECAST",
                "CLIMATE_PROJECTION"
              ],
              "type": "string"
            },
            "title": "Outlook Modes",
            "type": "array"
          },
          "priorities": {
            "default": [
              "avoid_crop_failure",
              "save_water",
              "soil_health"
            ],
            "items": {
              "enum": [
                "save_water",
                "avoid_crop_failure",
                "soil_health",
                "supplemental_income",
                "minimal_change"
              ],
              "type": "string"
            },
            "title": "Priorities",
            "type": "array"
          }
        },
        "required": [
          "field_id"
        ],
        "title": "PlanRequest",
        "type": "object"
      },
      "ReplanIn": {
        "properties": {
          "as_of": {
            "format": "date",
            "title": "As Of",
            "type": "string"
          },
          "completed": {
            "items": {
              "$ref": "#/components/schemas/CompletedSeason"
            },
            "minItems": 1,
            "title": "Completed",
            "type": "array"
          }
        },
        "required": [
          "as_of",
          "completed"
        ],
        "title": "ReplanIn",
        "type": "object"
      },
      "ScenarioOverride": {
        "properties": {
          "irrigation_cap_mm": {
            "anyOf": [
              {
                "maximum": 3000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Irrigation Cap Mm"
          },
          "rain_delta_pct": {
            "anyOf": [
              {
                "maximum": 200.0,
                "minimum": -90.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rain Delta Pct"
          },
          "salinity_onset_shift_weeks": {
            "anyOf": [
              {
                "maximum": 12.0,
                "minimum": -12.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Salinity Onset Shift Weeks"
          },
          "sow_shift_days": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "{\"2\": -10} = vụ 2 gieo sớm 10 ngày",
            "title": "Sow Shift Days",
            "type": "object"
          },
          "temp_delta_c": {
            "anyOf": [
              {
                "maximum": 6.0,
                "minimum": -5.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temp Delta C"
          }
        },
        "title": "ScenarioOverride",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WhatIfIn": {
        "properties": {
          "override": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScenarioOverride"
              },
              {
                "type": "null"
              }
            ]
          },
          "priorities": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "save_water",
                    "avoid_crop_failure",
                    "soil_health",
                    "supplemental_income",
                    "minimal_change"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Priorities"
          }
        },
        "title": "WhatIfIn",
        "type": "object"
      }
    }
  },

# FieldShift API (apps/api). Start it with `make api-dev`.
# VITE_API_BASE_URL=http://localhost:8000

# Worldwide place search (Photon, OpenStreetMap). Default: https://photon.komoot.io/api/
# Sends the typed query to that service. Set to "off" to search only the built-in Mekong gazetteer.
# VITE_GEOCODER_URL=off

# High-resolution imagery tiles used when zoomed in close ({z}/{y}/{x} placeholders).
# VITE_IMAGERY_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
